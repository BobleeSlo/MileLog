          }
        }
      }
    },
    "When enabled, the app starts trips automatically when you start driving and ends them when you stop." : {
      "localizations" : {
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ko je vklopljeno, aplikacija samodejno zazna začetek in konec vaše vožnje."
          }
        }
      }
    },
    "When on, MileLog asks for %@ each time you open it or return from the background." : {
      "localizations" : {
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ko je vklopljeno, MileLog zahteva %@ ob vsakem odprtju ali vrnitvi iz ozadja."
