          }
        }
      }
    },
    "All %lld automatic trips of the Free plan are used this month. Start trips manually, or subscribe. Automatic recording resumes on the 1st." : {
      "localizations" : {
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vseh %lld samodejnih voženj brezplačnega paketa je ta mesec porabljenih. Vožnje začnite ročno ali se naročite. Samodejno beleženje se nadaljuje 1. v mesecu."
