    "Terms of use" : {
      "localizations" : {
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pogoji uporabe"
          }
        }
      }
    },
    "Test builds only. The app behaves as if on this plan; your real subscription and the server are unchanged. App Store builds never show this." : {
      "localizations" : {
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Samo v testnih različicah. Aplikacija se obnaša, kot da imate ta paket; vaša dejanska naročnina in strežnik ostanejo nespremenjeni. Različice iz App Stora tega nikoli ne prikažejo."
          }
        }
      }
    },
    "That confirmation link didn't work" : {
      "localizations" : {
