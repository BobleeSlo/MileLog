          }
        }
      }
    },
    "This vehicle has no trips and will be removed permanently." : {
      "comment" : "A confirmation dialog message for deleting a vehicle.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To vozilo nima voženj in bo trajno odstranjeno."
