    "That reset link didn't work" : {
      "comment" : "The title of an alert that appears when a password reset link fails.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Povezava za ponastavitev ni delovala"
          }
        }
      }
    },
    "The Apple ID on this iPhone pays for a different MileLog account. Sign in with that account to use Paid, or subscribe with another Apple ID." : {
      "localizations" : {
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple ID na tem iPhonu plačuje za drug račun MileLog. Za plačljivi paket se prijavite s tem računom ali se naročite z drugim Apple ID-jem."
          }
        }
      }
    },
    "The account couldn't be deleted. Your data is still here — try again." : {
      "localizations" : {
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Računa ni bilo mogoče izbrisati. Vaši podatki so še tu — poskusite znova."
          }
        }
      }
    },
    "The car started moving again before you saved, so this was merged back into an ongoing drive. Your edits weren't saved — reclassify it once the drive ends." : {
      "comment" : "A message that appears when the user tries to dismiss a trip that's in progress.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vozilo se je znova premaknilo, preden ste shranili, zato je bila vožnja združena nazaj v potekajočo vožnjo. Vaše spremembe niso shranjene — razvrstite jo znova, ko se vožnja konča."
          }
        }
      }
    },
    "The month-end check lists %lld items for this month." : {
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "The month-end check lists %lld item for this month."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "The month-end check lists %lld items for this month."
                }
              }
            }
          }
        },
        "sl" : {
          "variations" : {
            "plural" : {
              "few" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Pregled ob koncu meseca navaja %lld postavke za ta mesec."
                }
              },
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Pregled ob koncu meseca navaja %lld postavko za ta mesec."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Pregled ob koncu meseca navaja %lld postavk za ta mesec."
                }
              },
              "two" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Pregled ob koncu meseca navaja %lld postavki za ta mesec."
                }
              }
            }
          }
        }
      }
    },
    "The server didn't accept this receipt. Try again — if it keeps failing, send the Detection log from Settings." : {
      "localizations" : {
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Strežnik računa ni sprejel. Poskusite znova — če se napaka ponavlja, pošljite dnevnik zaznav iz Nastavitev."
          }
        }
      }
    },
    "The two passwords don't match." : {
      "localizations" : {
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gesli se ne ujemata."
          }
        }
      }
    },
    "These trips were locked before they were checked. They stay as recorded and don't count as open items." : {
      "localizations" : {
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Te vožnje so bile zaklenjene, preden so bile pregledane. Ostanejo, kot so bile zabeležene, in se ne štejejo med odprte postavke."
          }
        }
      }
    },
    "This can't be undone. Export your trips as CSV first if you need a copy." : {
      "localizations" : {
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tega ni mogoče razveljaviti. Če potrebujete kopijo, vožnje najprej izvozite kot CSV."
          }
        }
      }
    },
    "This is taking longer than usual — your connection may be slow." : {
      "comment" : "A message that appears when the app is taking too long to load.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To traja dlje kot običajno — povezava je morda počasna."
          }
        }
      }
    },
    "This is taking longer than usual — your connection may be slow. Your trips are safe and will appear once it finishes." : {
      "comment" : "A description of the slow-but-alive connection that appears in the \"Syncing your trips…\" state.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To traja dlje kot običajno — povezava je morda počasna. Vaše vožnje so varne in se bodo prikazale, ko se konča."
          }
        }
      }
    },
    "This trip changed while open" : {
      "comment" : "A title for an alert that appears when the user tries to make changes to a trip that was changed by another user while it was open.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "sl" : {
          "stringUnit" : {
