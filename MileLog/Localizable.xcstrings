      }
    },
    "This vehicle has trips attached. It will be archived so those records stay intact — you can restore it later from the Vehicles list." : {
      "comment" : "A confirmation dialog message",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To vozilo ima povezane vožnje. Arhivirano bo, da evidenca ostane nedotaknjena — pozneje ga lahko obnovite s seznama vozil."
