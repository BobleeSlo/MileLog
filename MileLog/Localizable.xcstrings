    "Trips" : {
      "localizations" : {
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poti"
          }
        }
      }
    },
    "Trips in your other vehicles aren't recorded on the Free plan. All your vehicles, trips and receipts stay. Subscribe to record every vehicle again." : {
      "localizations" : {
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "V brezplačnem paketu se vožnje z drugimi vozili ne beležijo. Vsa vozila, vožnje in računi ostanejo. Naročite se, da se znova beležijo vsa vozila."
          }
        }
