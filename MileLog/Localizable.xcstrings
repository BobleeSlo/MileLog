        }
      }
    },
    "You're offline. Connect to the internet to delete your account — nothing was changed." : {
      "localizations" : {
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Niste povezani. Za izbris računa se povežite z internetom — nič ni bilo spremenjeno."
          }
        }
      }
    },
    "You've used all %lld automatic trips this month. Record trips manually, or subscribe to keep recording automatically." : {
      "localizations" : {
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta mesec ste porabili vseh %lld samodejnih voženj. Vožnje beležite ročno ali se naročite za nadaljnje samodejno beleženje."
          }
        }
      }
    },
    "Your sign-in" : {
      "localizations" : {
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vašo prijavo"
          }
        }
      }
    },
    "Your trips are private and only visible to you." : {
      "comment" : "A description of how user data is handled.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaše vožnje so zasebne in vidne samo vam."
          }
        }
      }
    },
    "Your trips are stored in your own Supabase project. Row-Level Security keeps every row private to your account." : {
      "extractionState" : "stale",
      "localizations" : {
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaše vožnje so shranjene v vašem lastnem Supabase projektu. Row-Level Security ohranja vsako vrstico zasebno za vaš račun."
          }
        }
      }
    },
