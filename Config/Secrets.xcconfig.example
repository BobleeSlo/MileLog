// Copy to Config/Secrets.xcconfig and fill in your own values.
// Secrets.xcconfig is gitignored; this .example file is not, so keep real
// values out of it.
//
// Write the URL with $() between the two slashes: an xcconfig file treats
// "//" as the start of a comment, and $() breaks the pair without changing
// the value.

SUPABASE_URL = https:/$()/YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY = sb_publishable_your_key_here
